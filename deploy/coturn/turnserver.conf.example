# BOOSTLAB coturn example
# Replace CHANGE_ME with the exact BOOSTLAB_TURN_SECRET used by boostlab-control.

listening-port=3478
tls-listening-port=5349

fingerprint
use-auth-secret
static-auth-secret=CHANGE_ME

realm=turn.example.com
server-name=turn.example.com

# Relay port range. Open this UDP range on the host firewall/NAT.
min-port=49160
max-port=49200

# Basic hardening.
no-cli
no-multicast-peers
stale-nonce=600

# Optional TLS. Uncomment and point to your certificate files.
# cert=/etc/letsencrypt/live/turn.example.com/fullchain.pem
# pkey=/etc/letsencrypt/live/turn.example.com/privkey.pem

# If the TURN server is behind NAT, set the public/private mapping.
# external-ip=PUBLIC_IP/PRIVATE_IP
