BOOSTLAB_CONTROL_HTTP_ADDR=:8090
# Add wireguard_public_key and wireguard_port after the real gateway key is generated.
BOOSTLAB_NODES_JSON=[{"id":"fra-1","region":"europe","country_code":"DE","city":"Frankfurt","display_name":"DE - Frankfurt","host":"203.0.113.10","udp_port":51821,"route_api_url":"https://fra-1.example.com","healthy":true}]


# Optional server-managed game catalog. Android merges these entries with its built-in catalog.
# Example:
# BOOSTLAB_GAMES_JSON=[{"title":"Example Game","tags":["HOT"]},{"title":"Another Game","tags":["NEW"]}]
BOOSTLAB_GAMES_JSON=


# Persistent squad chat history. Voice signaling is intentionally not persisted.
BOOSTLAB_SOCIAL_DATA_FILE=./data/social.json

# Optional TURN fallback for WebRTC voice. Use coturn REST auth (use-auth-secret + static-auth-secret). The shared secret never goes to Android.
# Multiple URLs are comma-separated.
BOOSTLAB_TURN_URLS=
BOOSTLAB_TURN_SECRET=
BOOSTLAB_TURN_TTL_SECONDS=1800


# Game route targets for Route Intelligence.
# Use real endpoints that are representative for the selected game.
# The same target IDs/hosts/ports must be deployed to every BOOSTLAB Gateway.
# Example:
# BOOSTLAB_GAME_ROUTES_JSON=[{"id":"game-eu-1","package_names":["com.example.game"],"host":"game.example.com","tcp_port":443}]
BOOSTLAB_GAME_ROUTES_JSON=


# Shared only between Control and Gateway for 90-second peer provisioning tickets.
# Use the exact same 32+ byte value on every BOOSTLAB Gateway.
# Generate once with: openssl rand -hex 32
BOOSTLAB_PROVISIONING_SECRET=


# Device admission. New phones need this code once, then their ECDSA public key is remembered.
# Generate something random, for example: openssl rand -hex 12
BOOSTLAB_DEVICE_AUTH_DATA_FILE=./data/devices.json
BOOSTLAB_ENROLLMENT_CODE=
